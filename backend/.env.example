# En tu computador apunta a la base de PRUEBAS (pamplohogar_dev), nunca a la de
# internet (neondb). Asi lo que se rompa probando no afecta a los estudiantes.
# La agrupada (lleva -pooler en el host): la usa la aplicacion en el dia a dia.
DATABASE_URL="postgresql://usuario:clave@host-pooler/pamplohogar_dev?sslmode=require"
# La directa (sin -pooler): solo para las migraciones.
DIRECT_URL="postgresql://usuario:clave@host/pamplohogar_dev?sslmode=require"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
PORT=4000
FRONTEND_URL="http://localhost:5173"
# Envio de correos (recuperar contrasena y confirmar cuenta). Sin esto la
# plataforma funciona igual, pero nadie puede recuperar su contrasena.
RESEND_API_KEY=""
CORREO_REMITENTE="PamploHogar <onboarding@resend.dev>"
# Clave de la tarea diaria que manda los avisos de busquedas guardadas.
# Vacia significa que la tarea queda apagada.
CLAVE_AVISOS=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
