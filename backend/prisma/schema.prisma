generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexion agrupada: aguanta mientras la base despierta y reparte las
  // consultas concurrentes sin abrir una conexion nueva para cada una.
  url = env("DATABASE_URL")
  // Conexion directa: solo para migraciones, que la agrupada no soporta.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ESTUDIANTE
  ARRENDADOR
  ADMIN
}

enum TipoInmueble {
  HABITACION
  APARTAESTUDIO
  APARTAMENTO
  CASA
}

enum MotivoReporte {
  PRECIO_ABUSIVO
  INFORMACION_FALSA
  NO_EXISTE
  NO_RESPONDE
  TRATO_IRRESPETUOSO
  OTRO
}

enum EstadoReporte {
  PENDIENTE
  ATENDIDO
  DESCARTADO
}

enum TipoToken {
  RECUPERAR_CLAVE
  VERIFICAR_CORREO
}

enum RitmoDeVida {
  MADRUGADOR
  NOCTURNO
  MIXTO
}

enum ConQuienConvivir {
  CUALQUIERA
  SOLO_MUJERES
  SOLO_HOMBRES
}

enum AccionAdmin {
  OCULTO_INMUEBLE
  MOSTRO_INMUEBLE
  ELIMINO_INMUEBLE
  ELIMINO_USUARIO
  CAMBIO_ROL
  ELIMINO_RESENA
  ELIMINO_RESENA_BARRIO
  ATENDIO_REPORTE
  DESCARTO_REPORTE
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  telefono     String?
  passwordHash String
  rol          Rol      @default(ESTUDIANTE)
  emailVerificadoEn DateTime?
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  inmuebles         Inmueble[]          @relation("InmueblesDelArrendador")
  favoritos         Favorito[]
  resenasEscritas   Resena[]            @relation("ResenasEscritas")
  resenasDeBarrio   ResenaBarrio[]      @relation("ResenasDeBarrio")
  resenasRecibidas  Resena[]            @relation("ResenasRecibidas")
  solicitudesHechas SolicitudContacto[] @relation("SolicitudesDelEstudiante")
  reportesHechos    Reporte[]           @relation("ReportesDelAutor")
  reportesAtendidos Reporte[]           @relation("ReportesAtendidos")
  tokens            TokenCorreo[]
  accionesDeAdmin   RegistroAdmin[]
  busquedas         BusquedaGuardada[]
  perfilRoomie      PerfilRoomie?
  contactosRoomie   ContactoRoomie[]    @relation("ContactosQueHizo")
  contactosRecibidos ContactoRoomie[]   @relation("ContactosQueRecibio")

  @@index([rol])
}

// Estudiante que busca con quien compartir arriendo.
//
// Un apartamento de 850 mil entre tres sale a 283 mil por cabeza, mas barato
// que casi cualquier habitacion sola. El problema nunca fue que no existieran
// esos apartamentos: era no tener con quien tomarlos.
model PerfilRoomie {
  id             String            @id @default(cuid())
  activo         Boolean           @default(true)
  presupuestoMax Int
  descripcion    String
  zonaPreferida  String?
  carrera        String?
  semestre       Int?
  ritmo          RitmoDeVida       @default(MIXTO)
  conQuien       ConQuienConvivir  @default(CUALQUIERA)
  fuma           Boolean           @default(false)
  tieneMascota   Boolean           @default(false)
  aceptaMascotas Boolean           @default(true)
  creadoEn       DateTime          @default(now())
  actualizadoEn  DateTime          @updatedAt

  // Uno por persona: dos perfiles de la misma cuenta solo confunden a quien busca.
  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contactos ContactoRoomie[]

  @@index([activo, presupuestoMax])
}

// Deja constancia de quien pidio el numero de quien, igual que con los inmuebles.
model ContactoRoomie {
  id       String   @id @default(cuid())
  creadoEn DateTime @default(now())

  solicitanteId String
  destinatarioId String
  perfilId      String

  solicitante  Usuario      @relation("ContactosQueHizo", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatario Usuario      @relation("ContactosQueRecibio", fields: [destinatarioId], references: [id], onDelete: Cascade)
  perfil       PerfilRoomie @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([solicitanteId, perfilId])
  @@index([destinatarioId])
}

// Una busqueda que el estudiante guardo para que le avisemos.
//
// Al empezar el semestre los cuartos buenos y baratos se van en horas. Quien
// tiene que entrar a revisar a cada rato pierde contra quien conoce a alguien.
// Esto empareja esa cancha.
model BusquedaGuardada {
  id       String  @id @default(cuid())
  nombre   String
  avisarPorCorreo Boolean @default(true)

  // Los mismos filtros del buscador. Todos opcionales.
  q            String?
  tipo         TipoInmueble?
  barrio       String?
  precioMin    Int?
  precioMax    Int?
  habitaciones Int?
  amoblado     Boolean?
  servicios    String[]      @default([])

  // Desde cuando se buscan novedades. Arranca en el momento de guardar para
  // no mandar de golpe todo lo que ya existia.
  revisadaHasta DateTime @default(now())
  ultimoAvisoEn DateTime?
  creadoEn      DateTime @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([avisarPorCorreo])
}

// Deja constancia de lo que hace cada administrador.
//
// Se guarda una descripcion en texto y no solo el id de lo afectado, porque
// casi siempre lo que se registra es un borrado: si guardaramos una relacion,
// al desaparecer el inmueble o la cuenta se perderia justo el rastro que
// queremos conservar.
model RegistroAdmin {
  id          String      @id @default(cuid())
  accion      AccionAdmin
  descripcion String
  creadoEn    DateTime    @default(now())

  adminId String
  admin   Usuario @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([creadoEn])
  @@index([adminId])
}

// Enlaces de un solo uso que se mandan por correo, para recuperar la
// contrasena o confirmar la direccion.
//
// Se guarda el hash y nunca el codigo: si alguien llegara a leer la base de
// datos, no podria usar los enlaces que estan en camino.
model TokenCorreo {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  tipo      TipoToken
  expiraEn  DateTime
  usadoEn   DateTime?
  creadoEn  DateTime  @default(now())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([expiraEn])
}

model Inmueble {
  id           String       @id @default(cuid())
  titulo       String
  descripcion  String
  tipo         TipoInmueble
  precio       Int
  barrio       String
  direccion    String
  lat          Float
  lng          Float
  habitaciones Int          @default(1)
  banos        Int          @default(1)
  servicios    String[]     @default([])
  amoblado     Boolean      @default(false)
  activo       Boolean      @default(true)
  creadoEn     DateTime     @default(now())
  actualizadoEn DateTime    @updatedAt

  arrendadorId String
  arrendador   Usuario @relation("InmueblesDelArrendador", fields: [arrendadorId], references: [id], onDelete: Cascade)

  fotos          FotoInmueble[]
  favoritos      Favorito[]
  solicitudes    SolicitudContacto[]
  resenas        Resena[]
  reportes       Reporte[]
  cambiosDePrecio CambioDePrecio[]

  @@index([arrendadorId])
  @@index([activo, precio])
  @@index([tipo])
  @@index([barrio])
}

model FotoInmueble {
  id         String @id @default(cuid())
  url        String
  publicId   String
  orden      Int    @default(0)
  inmuebleId String

  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([inmuebleId])
}

model Favorito {
  id         String   @id @default(cuid())
  usuarioId  String
  inmuebleId String
  creadoEn   DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inmueble Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, inmuebleId])
  @@index([usuarioId])
}

model Resena {
  id            String   @id @default(cuid())
  calificacion  Int
  comentario    String
  creadoEn      DateTime @default(now())

  autorId      String
  arrendadorId String
  inmuebleId   String?

  autor      Usuario   @relation("ResenasEscritas", fields: [autorId], references: [id], onDelete: Cascade)
  arrendador Usuario   @relation("ResenasRecibidas", fields: [arrendadorId], references: [id], onDelete: Cascade)
  inmueble   Inmueble? @relation(fields: [inmuebleId], references: [id], onDelete: SetNull)

  @@unique([autorId, arrendadorId])
  @@index([arrendadorId])
}

// Aviso de un estudiante sobre una publicacion que no deberia estar.
model Reporte {
  id         String        @id @default(cuid())
  motivo     MotivoReporte
  detalle    String
  estado     EstadoReporte @default(PENDIENTE)
  creadoEn   DateTime      @default(now())
  atendidoEn DateTime?
  notaAdmin  String?

  autorId    String
  inmuebleId String
  atendidoPorId String?

  autor       Usuario  @relation("ReportesDelAutor", fields: [autorId], references: [id], onDelete: Cascade)
  inmueble    Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)
  atendidoPor Usuario? @relation("ReportesAtendidos", fields: [atendidoPorId], references: [id], onDelete: SetNull)

  @@unique([autorId, inmuebleId])
  @@index([estado, creadoEn])
  @@index([inmuebleId])
}

// Cada vez que un arrendador cambia el precio queda registrado.
// Sirve para que el estudiante vea si le estan subiendo el arriendo
// de un semestre a otro, que es una de las quejas mas comunes.
model CambioDePrecio {
  id             String   @id @default(cuid())
  precioAnterior Int
  precioNuevo    Int
  creadoEn       DateTime @default(now())

  inmuebleId String
  inmueble   Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([inmuebleId, creadoEn])
}

model SolicitudContacto {
  id           String   @id @default(cuid())
  estudianteId String
  inmuebleId   String
  creadoEn     DateTime @default(now())

  estudiante Usuario  @relation("SolicitudesDelEstudiante", fields: [estudianteId], references: [id], onDelete: Cascade)
  inmueble   Inmueble @relation(fields: [inmuebleId], references: [id], onDelete: Cascade)

  @@index([inmuebleId])
  @@index([estudianteId])
}

// Lo que un estudiante que ya vivio ahi sabe del barrio y el que llega de
// fuera no tiene como averiguar: si se duerme, si se puede caminar de noche,
// si pasa transporte. Es la parte del voz a voz que mas cuesta reemplazar.
model ResenaBarrio {
  id     String @id @default(cuid())
  // El nombre tal como lo escribio quien opina, para mostrarlo.
  barrio String
  // El mismo nombre sin acentos ni mayusculas, que es con lo que se agrupa.
  clave  String

  // Las tres van en el mismo sentido: 5 siempre es lo mejor. Si "ruido"
  // fuera de 1 a 5, nadie sabria si 5 es muy ruidoso o muy callado.
  tranquilidad Int
  seguridad    Int
  transporte   Int

  comentario String
  creadoEn   DateTime @default(now())

  autorId String
  autor   Usuario @relation("ResenasDeBarrio", fields: [autorId], references: [id], onDelete: Cascade)

  // Una opinion por persona y barrio: si no, alguien solo repite hasta que
  // el promedio diga lo que le convenga.
  @@unique([autorId, clave])
  @@index([clave])
}
