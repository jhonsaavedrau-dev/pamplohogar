{
  "name": "pamplohogar-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Videos de publicidad de PamploHogar, hechos con Remotion.",
  "scripts": {
    "ver": "remotion studio",
    "historia": "remotion render HistoriaSinConocidos videos/historia-sin-conocidos.mp4",
    "foto": "remotion still HistoriaSinConocidos videos/portada.png --frame=90",
    "tarjetas": "remotion still TarjetaGiro tarjetas/giro.png && remotion still TarjetaCierre tarjetas/cierre.png",
    "video": "remotion render VideoCompleto videos/pamplohogar.mp4",
    "video:precio": "remotion render VideoPrecio videos/pamplohogar-precio.mp4",
    "video:arrendadores": "remotion render VideoArrendadores videos/pamplohogar-arrendadores.mp4",
    "video:noche": "remotion render VideoNoche videos/pamplohogar-noche.mp4",
    "video:antes": "remotion render VideoAntesYDespues videos/pamplohogar-antes-y-despues.mp4",
    "video:recibo": "remotion render VideoRecibo videos/pamplohogar-recibo.mp4",
    "video:scroll": "remotion render VideoUnSoloScroll videos/pamplohogar-un-solo-scroll.mp4",
    "video:mapa": "remotion render VideoMapa videos/pamplohogar-mapa.mp4",
    "video:tarjetas": "remotion render VideoTarjetas videos/pamplohogar-tarjetas.mp4",
    "video:cifras": "remotion render VideoCuenta videos/pamplohogar-cifras.mp4",
    "video:cartel": "remotion render VideoCartel videos/pamplohogar-cartel.mp4",
    "video:llamadas": "remotion render VideoLlamadas videos/pamplohogar-llamadas.mp4",
    "video:calendario": "remotion render VideoCalendario videos/pamplohogar-calendario.mp4",
    "video:ficha": "remotion render VideoFicha videos/pamplohogar-ficha.mp4",
    "video:contraste": "remotion render VideoContraste videos/pamplohogar-contraste.mp4",
    "videos": "npm run video && npm run video:precio && npm run video:arrendadores && npm run video:noche && npm run video:antes && npm run video:recibo && npm run video:scroll && npm run video:mapa && npm run video:tarjetas && npm run video:cifras && npm run video:cartel && npm run video:llamadas && npm run video:calendario && npm run video:ficha && npm run video:contraste"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "typescript": "^5.7.2"
  }
}
